# ============================================================
# A股短线交易助手 环境配置（复制本文件为 .env 并填写）
# ============================================================

# Tushare Token（必填，https://tushare.pro 注册获取，基础接口需>=120积分）
# 用到的接口：daily / stock_basic / trade_cal（120积分即可）
TUSHARE_TOKEN=你的tushare_token

# DeepSeek 大模型（必填，https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型ID（deepseek-flash = DeepSeek-V4.1-Flash；也可用 deepseek-v4-pro / deepseek-chat）
DEEPSEEK_MODEL=deepseek-flash

# Tavily 联网搜索（可选，用于当日政策/热点资讯检索，https://tavily.com）
TAVILY_API_KEY=tvly-xxx

# ============================================================
# 账户系统（网页版多用户）
# ============================================================
# 用于加密用户自配的API Key（生产环境务必改为随机长字符串，与 st.secrets 保持一致）
SECRET_KEY=请改为随机字符串

# 账户存储后端：local=本地JSON文件（单机默认）；supabase=Streamlit Cloud 云端持久化
AUTH_BACKEND=local

# Supabase 配置（仅 AUTH_BACKEND=supabase 时需要，建表SQL见README）
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=service_role密钥（仅服务端使用，勿泄露）
